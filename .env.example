# ---------------------------------------------------------------------------
# Copy to .env.local and fill in real values. .env.local is git-ignored.
# ---------------------------------------------------------------------------

# MongoDB Atlas connection string (server-side only — never prefix with NEXT_PUBLIC_)
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0&retryWrites=true&w=majority"

# Database name used by the app
MONGODB_DB="fables_lab"

# Salt used to hash client IPs on contact submissions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONTACT_HASH_SALT="change-me-to-a-long-random-string"

# Password for /admin/inquiries and /admin/projects/new.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_PASSWORD="change-me"